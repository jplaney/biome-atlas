# Raw source data (150 MB shapefile) — re-downloaded by build_biomes when needed
data/raw/

# Climate caches — regenerated by the pipeline; not part of the site
data/cache/
data/cache_today/

# Python
__pycache__/
*.pyc

# Deploy artifact assembled by CI
_site/

# The committed data/processed/*.json (biomes.geojson, stats.json, today.json)
# is intentionally NOT ignored — it's the precomputed content the site serves.
